AURELS_API_URL=https://www.aurels.dev
# Leave API key empty for the default offline local-policy mode.
AURELS_API_KEY=
AURELS_MODE=remote
AURELS_TIMEOUT_MS=1500
AURELS_TELEMETRY_ENABLED=true
# Opt into local disk persistence/replay for redacted telemetry when API delivery is offline.
AURELS_TELEMETRY_DURABLE=false
AURELS_HERMES_TRUST_NATIVE_HOOK_ORDER=false
# Optional override; defaults to the OS Aurels state directory.
# AURELS_TELEMETRY_SPOOL_DIR=
