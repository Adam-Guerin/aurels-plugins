{
  "id": "aurel",
  "name": "Aurel Security Middleware",
  "description": "Intercepts OpenClaw tool calls before execution and enforces Aurel security decisions.",
  "version": "0.1.0",
  "uiHints": {
    "apiKey": {
      "label": "Aurel API key",
      "placeholder": "aurel_...",
      "sensitive": true
    }
  },
  "setup": {
    "providers": [
      {
        "id": "aurel",
        "envVars": ["AUREL_API_URL", "AUREL_API_KEY"]
      }
    ]
  },
  "cliCommands": [
    {
      "name": "aurel",
      "description": "Show Aurel plugin status."
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean", "default": true },
      "apiUrl": { "type": "string" },
      "apiKey": { "type": "string" },
      "failMode": { "enum": ["open", "closed"], "default": "closed" },
      "failOpenPrivilegedActions": { "enum": ["block", "allow"], "default": "block" },
      "timeoutMs": { "type": "number", "minimum": 100, "maximum": 30000, "default": 1500 },
      "logLevel": { "enum": ["silent", "error", "warn", "info", "debug"], "default": "warn" },
      "telemetry": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "includeResults": { "type": "boolean", "default": false },
          "maxPayloadBytes": { "type": "number", "minimum": 1024, "maximum": 262144, "default": 32768 }
        }
      },
      "approval": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "nativeDirective": { "type": "boolean", "default": false },
          "timeoutMs": { "type": "number", "minimum": 1000, "maximum": 3600000, "default": 60000 }
        }
      },
      "rewrite": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "unsupportedFallback": { "enum": ["approval", "block"], "default": "approval" },
          "unsupportedTools": { "type": "array", "items": { "type": "string" }, "default": [] }
        }
      },
      "tools": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "include": { "type": "array", "items": { "type": "string" }, "default": [] },
          "exclude": { "type": "array", "items": { "type": "string" }, "default": [] }
        }
      },
      "redaction": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": true }
        }
      }
    }
  }
}
