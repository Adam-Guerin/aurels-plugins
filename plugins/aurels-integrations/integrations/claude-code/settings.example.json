{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/plugins/aurels-integrations/integrations/claude-code/hooks/aurel-hook.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/plugins/aurels-integrations/integrations/claude-code/hooks/aurel-hook.mjs"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/plugins/aurels-integrations/integrations/claude-code/hooks/aurel-hook.mjs"
          }
        ]
      }
    ]
  }
}
