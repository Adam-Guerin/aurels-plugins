{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "integrations/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "legacy/**",
    "node_modules/**"
  ]
}
