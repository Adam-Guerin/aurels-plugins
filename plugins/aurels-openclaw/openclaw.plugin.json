{
  "id": "aurels",
  "name": "Aurels Security",
  "version": "0.2.2",
  "description": "Pre-execution Aurels policy enforcement for OpenClaw tool calls.",
  "activation": {
    "onCapabilities": ["hook"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean" },
      "apiUrl": { "type": "string" },
      "apiKey": { "type": "string" },
      "mode": { "enum": ["local", "remote"] },
      "timeoutMs": { "type": "number", "minimum": 100, "maximum": 30000 },
      "telemetry": { "type": "boolean" }
    }
  }
}
