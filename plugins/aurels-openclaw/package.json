{
  "name": "@aurels/openclaw-plugin",
  "version": "0.2.3",
  "description": "Independent Aurels security hook for OpenClaw tool calls.",
  "type": "module",
  "main": "./src/index.js",
  "exports": "./src/index.js",
  "files": ["src", "docs", "README.md", "CHANGELOG.md", "LICENSE", "openclaw.plugin.json", ".env.example"],
  "scripts": {
    "test": "node --test tests/security.test.js && node --test tests/integration.test.js",
    "check": "node --check src/index.js && node --check src/security.js"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.2"
  },
  "openclaw": {
    "extensions": ["./src/index.js"]
  },
  "license": "MIT"
}
